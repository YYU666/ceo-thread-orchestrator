{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/ceoflow.external_execution_receipt.v2.schema.json",
  "title": "CEO Flow external execution receipt v2 R0/R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "taskId",
    "taskSha256",
    "projectId",
    "projectIdentitySha256",
    "laneRole",
    "projectRoleThreadId",
    "runId",
    "executionEpoch",
    "runReservationId",
    "contextViewId",
    "contextViewSha256",
    "startedAt",
    "completedAt",
    "attempt",
    "terminalStatus",
    "failure",
    "result",
    "route",
    "usage",
    "budget",
    "sourceRefs",
    "changedFiles",
    "writeSetCompliance",
    "commands",
    "tests",
    "artifacts",
    "workspaceFingerprint",
    "authorizationLease",
    "provenance",
    "forbiddenPayloadsPresent",
    "run",
    "visibleThread"
  ],
  "properties": {
    "schema": { "const": "ceoflow.external_execution_receipt.v2" },
    "taskId": { "$ref": "#/$defs/id" },
    "taskSha256": { "$ref": "#/$defs/sha256" },
    "projectId": { "$ref": "#/$defs/id" },
    "projectIdentitySha256": { "$ref": "#/$defs/sha256" },
    "laneRole": { "$ref": "#/$defs/laneRole" },
    "projectRoleThreadId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "executionEpoch": { "type": "integer", "minimum": 1 },
    "runReservationId": { "$ref": "#/$defs/id" },
    "contextViewId": { "$ref": "#/$defs/id" },
    "contextViewSha256": { "$ref": "#/$defs/sha256" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "attempt": { "const": 1 },
    "terminalStatus": { "enum": ["succeeded", "failed", "cancelled", "budget_exhausted"] },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "result": { "type": "string", "maxLength": 16000 },
    "route": { "$ref": "#/$defs/actualRoute" },
    "usage": { "$ref": "#/$defs/usage" },
    "budget": { "$ref": "#/$defs/budgetSnapshot" },
    "sourceRefs": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/sourceRef" } }
      ]
    },
    "changedFiles": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
      ]
    },
    "writeSetCompliance": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/writeSetCompliance" }
      ]
    },
    "commands": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/hostTrace" } },
    "tests": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/hostTrace" } },
    "artifacts": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/artifact" } },
    "workspaceFingerprint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "before", "after"],
          "properties": {
            "status": { "const": "partial" },
            "before": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
            "after": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] }
          },
          "oneOf": [
            { "properties": { "before": { "$ref": "#/$defs/sha256" }, "after": { "type": "null" } } },
            { "properties": { "before": { "type": "null" }, "after": { "$ref": "#/$defs/sha256" } } }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "before", "after"],
          "properties": {
            "status": { "const": "available" },
            "before": { "$ref": "#/$defs/sha256" },
            "after": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "before", "after"],
          "properties": {
            "status": { "const": "unavailable" },
            "before": { "type": "null" },
            "after": { "type": "null" }
          }
        }
      ]
    },
    "authorizationLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "leaseId", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "leaseId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "status": { "enum": ["not-issued", "consumed"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "task", "run", "evidence"],
      "properties": {
        "authority": { "const": "host-owned" },
        "task": { "const": "validated-g2" },
        "run": { "const": "matching-active-task-run-ledger" },
        "evidence": { "const": "terminal-g6a-host-run-evidence-ledger" }
      }
    },
    "forbiddenPayloadsPresent": { "const": false },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed", "closedAt", "ephemeralCleanup"],
      "properties": {
        "closed": { "const": true },
        "closedAt": { "type": "string", "format": "date-time" },
        "ephemeralCleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serializedProviderBodies", "providerCallMap", "toolCallMap", "governorInternal", "rawToolBodiesStored"],
          "properties": {
            "serializedProviderBodies": { "const": true },
            "providerCallMap": { "const": true },
            "toolCallMap": { "const": true },
            "rawToolBodiesStored": { "const": false },
            "governorInternal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requestLedgerEntries", "toolLedgerEntries", "pendingProviderCalls", "pendingToolReservations", "reservedProviderInputTokens", "reservedToolResultBytes", "grossTokenEvents", "sealed"],
              "properties": {
                "requestLedgerEntries": { "const": 0 },
                "toolLedgerEntries": { "const": 0 },
                "pendingProviderCalls": { "const": 0 },
                "pendingToolReservations": { "const": 0 },
                "reservedProviderInputTokens": { "const": 0 },
                "reservedToolResultBytes": { "const": 0 },
                "grossTokenEvents": { "const": 0 },
                "sealed": { "const": true }
              }
            }
          }
        }
      }
    },
    "visibleThread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveState", "archivedAt"],
      "properties": {
        "archiveState": { "const": "active" },
        "archivedAt": { "type": "null" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "terminalStatus": { "const": "succeeded" } }, "required": ["terminalStatus"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "sourceRefs": { "type": "array" },
          "changedFiles": { "type": "array" },
          "writeSetCompliance": {
            "type": "object",
            "properties": { "status": { "const": "compliant" } }
          },
          "workspaceFingerprint": {
            "required": ["status"],
            "properties": { "status": { "const": "available" } }
          },
          "budget": {
            "properties": { "fuseTripped": { "type": "null" } }
          },
          "route": {
            "properties": {
              "actualProvider": { "type": "string", "minLength": 1 },
              "actualModel": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "else": { "properties": { "failure": { "$ref": "#/$defs/failure" } } }
    },
    {
      "if": { "properties": { "terminalStatus": { "const": "failed" } }, "required": ["terminalStatus"] },
      "then": {
        "properties": {
          "failure": {
            "properties": {
              "code": { "not": { "enum": ["ERR_TASK_CANCELLED", "ERR_TASK_BUDGET"] } },
              "limit": { "type": "null" }
            }
          },
          "budget": { "properties": { "fuseTripped": { "type": "null" } } }
        }
      }
    },
    {
      "if": { "properties": { "terminalStatus": { "const": "cancelled" } }, "required": ["terminalStatus"] },
      "then": {
        "properties": {
          "failure": { "properties": { "code": { "const": "ERR_TASK_CANCELLED" }, "limit": { "type": "null" } } },
          "budget": { "properties": { "fuseTripped": { "type": "null" } } }
        }
      }
    },
    {
      "if": { "properties": { "terminalStatus": { "const": "budget_exhausted" } }, "required": ["terminalStatus"] },
      "then": {
        "properties": {
          "failure": {
            "properties": {
              "code": { "const": "ERR_TASK_BUDGET" },
              "limit": { "$ref": "#/$defs/budgetLimit" }
            }
          },
          "budget": { "properties": { "fuseTripped": { "$ref": "#/$defs/budgetLimit" } } }
        },
        "oneOf": [
          { "properties": { "failure": { "properties": { "limit": { "const": "maxWallTimeMs" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxWallTimeMs" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxModelRequests" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxModelRequests" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxInputTokensPerRequest" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxInputTokensPerRequest" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxCumulativeInputTokens" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxCumulativeInputTokens" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxToolCalls" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxToolCalls" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxCumulativeToolResultBytes" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxCumulativeToolResultBytes" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxProviderCalls" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxProviderCalls" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxToolResultBytesPerCall" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxToolResultBytesPerCall" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxCumulativeUncachedInputTokens" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxCumulativeUncachedInputTokens" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxCumulativeCachedInputTokens" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxCumulativeCachedInputTokens" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxCumulativeGrossTokens" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxCumulativeGrossTokens" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "maxGrossTokensPerMinute" } } }, "budget": { "properties": { "fuseTripped": { "const": "maxGrossTokensPerMinute" } } } } },
          { "properties": { "failure": { "properties": { "limit": { "const": "requestSerialization" } } }, "budget": { "properties": { "fuseTripped": { "const": "requestSerialization" } } } } }
        ]
      }
    },
    {
      "if": {
        "properties": { "budget": { "properties": { "class": { "const": "R0" } }, "required": ["class"] } },
        "required": ["budget"]
      },
      "then": {
        "properties": {
          "authorizationLease": {
            "properties": {
              "required": { "const": false },
              "leaseId": { "type": "null" },
              "status": { "const": "not-issued" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "terminalStatus": { "const": "succeeded" } }, "required": ["terminalStatus"] },
            "then": { "properties": { "changedFiles": { "type": "array", "maxItems": 0 } } }
          }
        ]
      },
      "else": {
        "properties": {
          "changedFiles": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/r1RelativePath" } }
            ]
          },
          "writeSetCompliance": {
            "oneOf": [
              { "type": "null" },
              {
                "allOf": [
                  { "$ref": "#/$defs/writeSetCompliance" },
                  {
                    "properties": {
                      "declaredPaths": { "items": { "$ref": "#/$defs/r1RelativePath" } },
                      "violationPaths": { "items": { "$ref": "#/$defs/r1RelativePath" } }
                    }
                  }
                ]
              }
            ]
          },
          "commands": {
            "items": {
              "properties": {
                "artifactRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/r1RelativePath" }] }
              }
            }
          },
          "tests": {
            "items": {
              "properties": {
                "artifactRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/r1RelativePath" }] }
              }
            }
          },
          "artifacts": {
            "items": {
              "properties": { "relativePath": { "$ref": "#/$defs/r1RelativePath" } }
            }
          },
          "authorizationLease": {
            "properties": {
              "required": { "const": true },
              "leaseId": { "$ref": "#/$defs/id" },
              "status": { "const": "consumed" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "terminalStatus": { "const": "succeeded" } }, "required": ["terminalStatus"] },
            "then": {
              "properties": {
                "changedFiles": { "type": "array", "minItems": 1 },
                "commands": { "items": { "properties": { "exitCode": { "const": 0 } } } },
                "tests": { "minItems": 1, "items": { "properties": { "exitCode": { "const": 0 } } } }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*[/\\\\]$)(?!.*[/\\\\]{2})(?!.*(?:^|[/\\\\])[.]{1,2}(?:[/\\\\]|$))(?!.*(?:^|[/\\\\])(?:[.][cC][oO][dD][eE][xX]-[kK][nN][oO][wW][lL][eE][dD][gG][eE]|[.][cC][eE][oO][fF][lL][oO][wW]|[.][cC][oO][dD][eE][xX]-[cC][oO][nN][tT][rR][oO][lL]|[sS][eE][sS][sS][iI][oO][nN][sS]?|[cC][oO][nN][tT][rR][oO][lL][sS]?|[kK][nN][oO][wW][lL][eE][dD][gG][eE]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]?|[sS][eE][cC][rR][eE][tT][sS]?)(?:[/\\\\]|$))[^\\u0000]+$"
    },
    "r1RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[a-z0-9._@+-]*\\.(?:/|$))(?!.*(?:^|/)(?:con|prn|aux|nul|clock\\$|com[1-9]|lpt[1-9])(?:\\.[a-z0-9._@+-]+)?(?:/|$))(?!.*(?:^|/)(?:(?:node_modules|bower_components|jspm_packages|vendor|vendors|dependency|dependencies|deps|third_party|third-party|dist|build|out|output|coverage|generated|release|target|cache|caches|tmp|temp|\\.git|\\.hg|\\.svn|\\.cache|\\.ssh|\\.codex-knowledge|\\.ceoflow|\\.codex-control)|(?:(?:credentials?|secrets?|sessions?|controls?|knowledge|private|tokens?|password|api[_-]?key)(?:[._-][a-z0-9._@+-]*)?|(?:\\.env|\\.npmrc|\\.pypirc)(?:[._-][a-z0-9._@+-]*)?|(?:id_rsa|id_ed25519)(?:[._-][a-z0-9._@+-]*)?))(?:/|$))[a-z0-9._@+-]+(?:/[a-z0-9._@+-]+)*$"
    },
    "laneRole": { "enum": ["ceo", "implementation", "review", "qa", "research", "memory", "custom"] },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "ranges"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/sourceRange" }
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startLine", "lineCount"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "startLine": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "lineCount": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "limit"],
      "properties": {
        "code": { "type": "string", "pattern": "^ERR_[A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "limit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/budgetLimit" }
          ]
        }
      }
    },
    "writeSetCompliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "declaredPaths", "violationPaths"],
      "properties": {
        "status": { "enum": ["compliant", "violated", "not-applicable"] },
        "declaredPaths": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "violationPaths": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
      }
    },
    "hostTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "argv", "display", "hostObserved", "exitCode", "durationMs", "summary", "artifactRef", "artifactSha256"],
      "properties": {
        "traceId": { "$ref": "#/$defs/id" },
        "argv": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
        "display": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "hostObserved": { "const": true },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "maxLength": 4096 },
        "artifactRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/relativePath" }] },
        "artifactSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "relativePath", "sha256", "bytes"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "actualRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedProvider", "requestedModel", "actualProvider", "actualModel", "fallback", "retry", "reasoning", "runtime", "executionLocation"],
      "properties": {
        "requestedProvider": { "$ref": "#/$defs/id" },
        "requestedModel": { "type": "string", "minLength": 1, "maxLength": 256 },
        "actualProvider": { "type": "string", "maxLength": 128 },
        "actualModel": { "type": "string", "maxLength": 256 },
        "fallback": { "const": "deny" },
        "retry": { "const": 0 },
        "reasoning": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 128 },
        "executionLocation": { "const": "host" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported", "source", "providerCallCount", "inputTokens", "outputTokens", "cachedInputTokens", "cacheWriteTokens", "uncachedInputTokens", "grossTokens", "serializedInputChars", "serializedInputBytes", "toolCallCount", "deliveredToolResultBytes", "cost"],
      "properties": {
        "reported": { "type": "boolean" },
        "source": { "enum": ["provider", "host-estimate", "mixed"] },
        "providerCallCount": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "uncachedInputTokens": { "type": "integer", "minimum": 0 },
        "grossTokens": { "type": "integer", "minimum": 0 },
        "serializedInputChars": { "type": "integer", "minimum": 0 },
        "serializedInputBytes": { "type": "integer", "minimum": 0 },
        "toolCallCount": { "type": "integer", "minimum": 0 },
        "deliveredToolResultBytes": { "type": "integer", "minimum": 0 },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reported", "currency", "amount"],
          "properties": {
            "reported": { "type": "boolean" },
            "currency": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Z]{3}$" }] },
            "amount": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
          },
          "allOf": [
            {
              "if": { "properties": { "reported": { "const": true } }, "required": ["reported"] },
              "then": { "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "amount": { "type": "number", "minimum": 0 } } },
              "else": { "properties": { "currency": { "type": "null" }, "amount": { "type": "null" } } }
            }
          ]
        }
      }
    },
    "r0Budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxModelRequests", "maxToolCalls", "maxInputTokensPerRequest", "maxCumulativeInputTokens", "maxCumulativeToolResultBytes", "maxWallTimeMs"],
      "properties": {
        "maxModelRequests": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxInputTokensPerRequest": { "type": "integer", "minimum": 1, "maximum": 12000 },
        "maxCumulativeInputTokens": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "maxCumulativeToolResultBytes": { "type": "integer", "minimum": 1, "maximum": 12000 },
        "maxWallTimeMs": { "type": "integer", "minimum": 1, "maximum": 180000 }
      }
    },
    "r1Budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxModelRequests", "maxToolCalls", "maxInputTokensPerRequest", "maxCumulativeInputTokens", "maxCumulativeToolResultBytes", "maxWallTimeMs"],
      "properties": {
        "maxModelRequests": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxInputTokensPerRequest": { "type": "integer", "minimum": 1, "maximum": 16000 },
        "maxCumulativeInputTokens": { "type": "integer", "minimum": 1, "maximum": 48000 },
        "maxCumulativeToolResultBytes": { "type": "integer", "minimum": 1, "maximum": 48000 },
        "maxWallTimeMs": { "type": "integer", "minimum": 1, "maximum": 600000 }
      }
    },
    "budgetUsed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelRequests", "toolCalls", "inputTokens", "toolResultBytes", "wallTimeMs"],
      "properties": {
        "modelRequests": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "toolResultBytes": { "type": "integer", "minimum": 0 },
        "wallTimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "budgetLimit": {
      "enum": ["maxWallTimeMs", "maxModelRequests", "maxInputTokensPerRequest", "maxCumulativeInputTokens", "maxToolCalls", "maxCumulativeToolResultBytes", "maxProviderCalls", "maxToolResultBytesPerCall", "maxCumulativeUncachedInputTokens", "maxCumulativeCachedInputTokens", "maxCumulativeGrossTokens", "maxGrossTokensPerMinute", "requestSerialization"]
    },
    "budgetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "limits", "used", "remaining", "fuseTripped"],
      "properties": {
        "class": { "enum": ["R0", "R1"] },
        "limits": { "$ref": "#/$defs/r1Budgets" },
        "used": { "$ref": "#/$defs/budgetUsed" },
        "remaining": { "$ref": "#/$defs/budgetUsed" },
        "fuseTripped": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/budgetLimit" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "R0" } }, "required": ["class"] },
          "then": { "properties": { "limits": { "$ref": "#/$defs/r0Budgets" } } },
          "else": { "properties": { "limits": { "$ref": "#/$defs/r1Budgets" } } }
        }
      ]
    }
  }
}
